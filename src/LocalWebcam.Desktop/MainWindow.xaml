<Window
    x:Class="LocalWebcam.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LocalWebcam.Desktop.ViewModels"
    xmlns:converters="using:LocalWebcam.Desktop.Converters"
    xmlns:tb="using:H.NotifyIcon">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <!-- Transparent icon buttons: no filled chrome, just the glyph -
                 the video preview now fills the whole window, so buttons
                 overlay directly on top of it instead of sitting in an
                 opaque side panel. WinUI3's default Button template keys
                 its PointerOver/Pressed backgrounds off these theme resource
                 keys (not the Background property), and `Resources` isn't a
                 DependencyProperty so a Style Setter can't target it
                 (WMC0095) - overriding the keys here, at the window's own
                 resource scope, is the standard WinUI3 way to reach every
                 button under it via the normal ThemeResource lookup. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <!-- Same transparent treatment for the per-device Connect button
                 and the quality Apply button, which live inside the
                 semi-transparent overlay panel rather than the bottom bar. -->
            <Style x:Key="PanelIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="8" />
            </Style>
        </Grid.Resources>

        <!-- Non-visual: WinUI3 has no built-in tray icon, this is the
             standard library for it. Minimizing/closing to tray is handled
             in code-behind (MainWindow.xaml.cs) via the window's Closing
             event, not here. -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Local Webcam"
                        NoLeftClickDelay="True"
                        LeftClickCommand="{x:Bind ShowWindowCommand}"
                        ContextMenuMode="SecondWindow">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Show Local Webcam" Click="ShowMenuItem_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="ExitMenuItem_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- Full-window video preview - everything else overlays on top of
             this. Rendered via SwapChainVideoRenderer (code-behind) through
             its own DXGI composition swap chain rather than a XAML
             Image/WriteableBitmap - see that class's doc comment for why. -->
        <Grid Background="Black">
            <SwapChainPanel x:Name="PreviewSwapChainPanel" />
        </Grid>

        <!-- Devices/quality/stats overlay panel - toggled by the bottom
             bar's panel icon; starts hidden (see IsInfoPanelVisible's doc
             comment). Background is nearly opaque, not the ~80%-opaque
             value used for a while, which let the live video underneath
             show and shift through it - reported (and plausible: a
             translucent WinUI overlay recompositing against a 30fps-
             updating Image is a known category of visual artifact) as
             flickering. A hint of the video is still visible at the very
             edge/corners where content extends past the panel, but not
             through its main body. -->
        <Border Visibility="{Binding IsInfoPanelVisible, Converter={StaticResource BoolToVisibility}}"
                Background="#F51E1E1E"
                CornerRadius="12"
                Margin="20"
                Padding="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="360"
                MaxHeight="700">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <TextBlock Text="Local Webcam" FontSize="22" FontWeight="Bold" />

                    <TextBlock Text="Devices" FontSize="16" FontWeight="SemiBold" />
                    <!-- No per-device Connect button: select a device here (it
                         becomes SelectedDevice), then use the single
                         connect/disconnect toggle in the bottom bar. -->
                    <ListView ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiscoveredDeviceEntry">
                                <StackPanel Spacing="4" Padding="0,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Device.DisplayName}" FontWeight="SemiBold" />
                                        <Border Background="#333" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding TransportLabel}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Device.Address}" Opacity="0.7" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Quality:" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding QualityOptions}"
                                  SelectedIndex="{Binding SelectedQualityIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding IsQualityChangeAllowed}"
                                  Width="140" />
                        <Button Style="{StaticResource PanelIconButtonStyle}"
                                Command="{Binding ApplyQualityCommand}"
                                IsEnabled="{Binding IsQualityChangeAllowed}"
                                ToolTipService.ToolTip="Apply"
                                AutomationProperties.Name="Apply">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" />
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}" />

                    <StackPanel Orientation="Horizontal" Spacing="16" Visibility="{Binding IsPairingCodeVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Pairing code:" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PairingCode}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="Compare this code with the one shown on the phone, then Allow it there." Opacity="0.7" TextWrapping="Wrap" Visibility="{Binding IsPairingCodeVisible, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding FramesReceivedText}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Packet loss:" />
                        <TextBlock Text="{Binding PacketLossText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Decoded FPS:" />
                        <TextBlock Text="{Binding DecodedFpsText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Decode+render latency:" />
                        <TextBlock Text="{Binding LatencyText}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorText}" Foreground="Red" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom icon bar: transparent buttons over a dark scrim so they
             stay legible over any video content, in one horizontal row. -->
        <Grid VerticalAlignment="Bottom" Height="84">
            <Rectangle Fill="#99000000" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleInfoPanelCommand}" ToolTipService.ToolTip="Devices &amp; Info" AutomationProperties.Name="Devices and Info">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE700;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding SwitchCameraCommand}" ToolTipService.ToolTip="Switch Camera" AutomationProperties.Name="Switch Camera">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE89E;" />
                </Button>
                <!-- Single toggle instead of separate Connect/Disconnect
                     buttons - connects the currently selected device (from
                     the info panel's list) if idle, disconnects otherwise. -->
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleConnectionCommand}" ToolTipService.ToolTip="Connect/Disconnect" AutomationProperties.Name="Connect or Disconnect">
                    <Grid>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71B;" Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenLogFolderCommand}" ToolTipService.ToolTip="Open Log Folder" AutomationProperties.Name="Open Log Folder">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED25;" />
                </Button>
                <!-- A guaranteed way to exit that doesn't depend on the tray
                     icon's context menu - added after the tray menu's Exit
                     item was reported not working and couldn't be confirmed
                     firing at all (see ExitApp's doc comment). -->
                <Button Style="{StaticResource IconButtonStyle}" Click="ExitButton_Click" ToolTipService.ToolTip="Exit Local Webcam" AutomationProperties.Name="Exit Local Webcam">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
